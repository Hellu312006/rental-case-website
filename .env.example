# RentEase Environment Configurations Boilerplate
# Copy this file to a new file named '.env' and fill in the values below.

# Django parameters
SECRET_KEY=django-insecure-prod-key-goes-here-make-it-long-and-random
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTP / SSL Redirection (Set to 'False' if Nginx handles SSL redirection)
SECURE_SSL_REDIRECT=True
